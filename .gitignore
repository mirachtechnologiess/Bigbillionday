# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (secrets: NVIDIA key, AUTH_SECRET, DB password)
.env*.local
.env

# uploaded media lives on a persistent volume, not in git
storage/*
!storage/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
