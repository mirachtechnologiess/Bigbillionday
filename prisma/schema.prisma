generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum Gender {
  MEN
  WOMEN
  UNISEX
  KIDS
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentMethod {
  COD
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENT
  FLAT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?   @unique
  passwordHash String
  role         Role      @default(CUSTOMER)
  isBlocked    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlist     WishlistItem[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  logo        String?
  description String?
  country     String?
  isFeatured  Boolean   @default(false)
  sortOrder   Int       @default(0)
  seoTitle    String?
  seoDesc     String?
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  sortOrder   Int        @default(0)
  seoTitle    String?
  seoDesc     String?
  products    Product[]
}

model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  image       String?
  isActive    Boolean             @default(true)
  showOnHome  Boolean             @default(false)
  sortOrder   Int                 @default(0)
  products    CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model Product {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  sku              String        @unique
  modelNumber      String?
  brandId          String
  brand            Brand         @relation(fields: [brandId], references: [id])
  categoryId       String?
  category         Category?     @relation(fields: [categoryId], references: [id])
  gender           Gender        @default(UNISEX)
  shortDescription String?
  description      String?
  highlights       String[]
  price            Int
  mrp              Int
  costPrice        Int?
  stock            Int           @default(0)
  lowStockAt       Int           @default(3)
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  isNewArrival     Boolean       @default(false)
  isBestSeller     Boolean       @default(false)
  codAvailable     Boolean       @default(true)
  // watch specs (filterable)
  movement         String?
  caseMaterial     String?
  caseSize         Int?
  caseShape        String?
  dialColor        String?
  strapMaterial    String?
  strapColor       String?
  waterResistance  String?
  glass            String?
  display          String?
  features         String[]
  warranty         String?
  weightGrams      Int?
  specs            Json?
  tags             String[]
  seoTitle         String?
  seoDesc          String?
  aiGenerated      Boolean       @default(false)
  ratingAvg        Float         @default(0)
  ratingCount      Int           @default(0)
  soldCount        Int           @default(0)
  viewCount        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  images           ProductImage[]
  reviews          Review[]
  orderItems       OrderItem[]
  collections      CollectionProduct[]
  wishlistedBy     WishlistItem[]

  @@index([status, brandId])
  @@index([status, gender])
  @@index([price])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  width     Int?
  height    Int?
  blurData  String?
  position  Int     @default(0)
}

model Review {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  rating    Int
  title     String?
  body      String
  status    ReviewStatus @default(PENDING)
  verified  Boolean      @default(false)
  sentiment String?
  createdAt DateTime     @default(now())
}

model WishlistItem {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

model Coupon {
  id          String     @id @default(cuid())
  code        String     @unique
  description String?
  type        CouponType @default(PERCENT)
  value       Int
  minOrder    Int        @default(0)
  maxDiscount Int?
  usageLimit  Int?
  usedCount   Int        @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  email          String
  phone          String
  shippingName   String
  line1          String
  line2          String?
  landmark       String?
  city           String
  state          String
  pincode        String
  subtotal       Int
  discount       Int           @default(0)
  shippingFee    Int           @default(0)
  codFee         Int           @default(0)
  total          Int
  couponCode     String?
  paymentMethod  PaymentMethod @default(COD)
  paymentStatus  PaymentStatus @default(PENDING)
  razorpayId     String?
  status         OrderStatus   @default(PENDING)
  trackingNumber String?
  courier        String?
  notes          String?
  riskScore      Int?
  riskReason     String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          OrderItem[]
  events         OrderEvent[]

  @@index([status, createdAt])
  @@index([phone])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  brand     String
  sku       String
  image     String?
  price     Int
  quantity  Int
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

model Banner {
  id        String   @id @default(cuid())
  title     String
  subtitle  String?
  image     String?
  ctaLabel  String?
  ctaHref   String?
  badge     String?  // big discount callout, e.g. "UP TO 70% OFF"
  theme     String   @default("saffron") // saffron | teal | crimson | sun | forest | ink
  productId String?  // optional product whose photo/price the banner features
  startsAt  DateTime?
  endsAt    DateTime?
  placement String   @default("home_hero")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Setting {
  key   String @id
  value Json
}

model Newsletter {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AiLog {
  id        String   @id @default(cuid())
  task      String
  model     String
  tokens    Int?
  ok        Boolean  @default(true)
  error     String?
  createdAt DateTime @default(now())
}
