# --- Core ---
NEXT_PUBLIC_SITE_URL=https://premiumshopy.com
DATABASE_URL=postgresql://premiumshopy:premiumshopy@127.0.0.1:5432/premiumshopy?schema=public
# 32+ random chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=change-me-to-a-long-random-string

# --- First admin (created by `npm run db:seed`) ---
ADMIN_EMAIL=admin@premiumshopy.com
ADMIN_PASSWORD=ChangeMe@123

# --- NVIDIA NIM (AI features) ---
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEXT_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# --- Razorpay (enable later from Admin > Settings) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Uploads (local disk; mounted as a volume in Docker/K8s) ---
UPLOAD_DIR=./storage/uploads
